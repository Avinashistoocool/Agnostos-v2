# =============================================================================
#  Agnostos - configuration
#  Copy this file to `.env`, fill in section 1, and you are ready to go.
#  `.env` is git-ignored. Never commit it.
# =============================================================================
#
#  JUST WANT PERSONALISED EMAILS FROM YOUR RESUME? Fill section 1 only.
#
#      python -m outreach.cli models              # see what your key can run
#      python -m outreach.cli run  --mode list    # score + draft
#      python -m outreach.cli send --dry-run      # preview
#      python -m outreach.cli send --live --top 10
#
#  Sections 2-6 all have working defaults. Touch them only when you want to.
# =============================================================================


# =============================================================================
#  1. REQUIRED - fill these four things in
# =============================================================================

# --- Your resume (PDF or DOCX). Everything is personalised from this file. ---
RESUME_PATH=C:\path\to\your_CV.pdf

# --- The professor list to score and draft for. ---
#   Any .xlsx with a name + email column. See README for the header mapping.
TARGET_XLSX=C:\path\to\targets.xlsx

# --- Which LLM to use: groq | openai ---
#   groq is the default because it costs nothing. Get a key in ~30 seconds at
#   https://console.groq.com/keys and paste it below - that is the whole setup.
LLM_PROVIDER=groq

#   groq : https://console.groq.com/keys   (free tier, very fast)
GROQ_API_KEY=gsk_REPLACE_ME

#   openai : https://platform.openai.com/api-keys   (paid, only if you prefer it)
OPENAI_API_KEY=

# --- Outgoing mail. Only needed for `send --live`, not for drafting. ---
#   Gmail        : host smtp.gmail.com, port 587, password = 16-char App Password
#                  (https://myaccount.google.com/apppasswords - needs 2FA on)
#   Outlook/365  : host smtp.office365.com, port 587
#   University   : ask IT for the SMTP host; SMTP_USER is often your full address
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@your-university.edu
SMTP_PASSWORD=your_app_password
SMTP_FROM=you@your-university.edu
SMTP_FROM_NAME=Your Full Name


# =============================================================================
#  2. How you want to be pitched
#     These three strings go straight into the prompt. Making them specific
#     measurably improves the drafts - especially AVAILABILITY.
# =============================================================================

POSITION=summer research internship (undergraduate)
GEOGRAPHY=Europe (EU + Switzerland + UK)
AVAILABILITY=May-July 2027, 8-12 weeks, flexible
# Can you pay your own travel/living costs? yes | no | blank (= not stated).
# Used when drafting replies to professors who mention funding.
CAN_SELF_FUND=
# Optional detail, e.g. "family support covers travel and 3 months' rent".
SELF_FUND_NOTE=


# =============================================================================
#  3. Model and spend
# =============================================================================

# Run `python -m outreach.cli models` to list exactly what your key can reach -
# provider catalogues change, so prefer that over any hardcoded list.
#
#   Groq (free)  : openai/gpt-oss-120b (default) | openai/gpt-oss-20b
#   OpenAI (paid): gpt-4.1 | gpt-5-mini | gpt-4.1-mini | gpt-4o-mini
#
# Leave both blank to use the provider default.
DRAFT_MODEL=
SCORE_MODEL=

# Hard ceiling in USD. The run shows an estimate and asks [Y/N] before spending
# anything, and aborts mid-run if this is reached. Ignored on free providers.
BUDGET_USD=5.0

# How many professors may reach the LLM. Everything above the local-match
# threshold, ranked, capped here.
MAX_PROFESSORS=50

# Local match score 0-1. Raise to 0.4 to only contact very close matches;
# lower to 0.15 to cast wider.
MIN_LOCAL_SCORE=0.25

# Per-email generation ceiling. Raise if drafts come back truncated.
MAX_OUTPUT_TOKENS=1100

# Optional: Azure, OpenRouter, or any other OpenAI-compatible endpoint.
# Only used when LLM_PROVIDER=openai.
OPENAI_BASE_URL=


# =============================================================================
#  4. Sending behaviour
# =============================================================================

# Attached to every email. Semicolon-separated. Your CV belongs here;
# add a transcript if you have one.
ATTACHMENTS=C:\path\to\your_CV.pdf

# Random gap between sends, in seconds. Do not lower these - identical
# intervals are exactly what spam filters look for. University relays
# throttle hard; if you see SMTPServerDisconnected, raise these to 300/600.
SEND_DELAY_MIN=90
SEND_DELAY_MAX=240

# Stop after this many per run. Gmail free accounts cap near 500/day, but
# a trickle of 20-25 cold emails looks far more human.
DAILY_SEND_CAP=25

# Only email professors scoring at or above this probability. 0 = send to all
# drafted rows. Set 60 to avoid burning your name on weak matches.
# For a one-off cap, `send --top 10` mails the 10 strongest matches instead.
SEND_MIN_PROBABILITY=0

# Where replies should go, if different from SMTP_FROM.
REPLY_TO=

# Only send when it is these hours in the professor's own timezone (from the
# Country column), weekdays only. e.g. 9-11. Blank = send any time.
SEND_LOCAL_WINDOW=

# Reply tracking (`check-replies`). Blank = derive from the SMTP settings
# (smtp.x -> imap.x, same login). Folders are semicolon-separated.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDERS=INBOX;SPAM;Junk;Junk Email

# starttls (port 587, usual) | ssl (port 465) | none
SMTP_SECURITY=starttls

# Seconds to wait on the mail server. University servers throttle aggressively;
# raise this if you see 'read operation timed out'.
SMTP_TIMEOUT=60


# =============================================================================
#  5. Humanising layer
#     Every draft is de-sloped for free, scored for AI tells, and only sent
#     back to the model for a rewrite when it still reads synthetic.
# =============================================================================

HUMANIZE_REWRITE=true

# AI-tell score at or above which a paid rewrite is triggered. Raise to spend
# less, lower to rewrite more aggressively.
HUMANIZE_THRESHOLD=10


# =============================================================================
#  6. Publication enrichment (free, and what makes the drafts specific)
#     Looks up each professor's recent first/last-author papers so the email
#     can open on their actual work instead of a generic compliment.
# =============================================================================

USE_OPENALEX=true

# Strongly recommended. Free, instant, and avoids the shared per-IP rate
# limit that will otherwise cut enrichment short: https://openalex.org/
OPENALEX_API_KEY=
OPENALEX_MAILTO=you@your-university.edu

# Papers fetched per professor.
OPENALEX_WORKS=4

# --- Batched discovery: `python -m outreach.cli discover` ---
# Total professors to find, split evenly into this many batches. Each batch
# saves to the workbook as soon as it finishes; re-running the same command
# resumes at the first unfinished batch.
DISCOVER_COUNT=1000
DISCOVER_BATCHES=4
# One research topic per batch, separated by ';'. Fewer topics than batches
# is fine: a reused topic continues from where the previous batch stopped.
# Empty = use the research interests parsed from your resume.
DISCOVER_QUERIES=
# Region name (europe, eu, dach, nordics, uk, usa, northamerica, asia, anz)
# or ISO codes like de,ch,gb.
DISCOVER_COUNTRIES=europe
DISCOVER_SINCE=2021
# Upper bound on pages of 100 papers read per batch.
DISCOVER_MAX_PAGES=40
# Only search the region's N best universities (ranked by highly-cited papers),
# favouring higher-ranked ones. 0 = off (any institution).
DISCOVER_TOP_UNIVERSITIES=0
# With the above: 0 = topic fit only, 1 = balanced, 3 = mostly prestige.
DISCOVER_PRESTIGE_WEIGHT=1.0
# Parallel lookups for `verify --repair` (web pages are slow; 4 is polite).
VERIFY_WORKERS=4

# Results are cached in output/openalex_cache.json, so re-runs are free.


# =============================================================================
#  7. Scraper - Mode A only (`run --mode scrape`)
#     Ignore this entire section if you are working from a target list.
# =============================================================================

RESPECT_ROBOTS=true
SCRAPE_HEADLESS=true
SCRAPE_DELAY_MIN=4
SCRAPE_DELAY_MAX=11

# Residential proxy, if you have one. A blocked page triggers a fresh
# browser fingerprint and a new proxy exit.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Directory pages to scrape are listed in sources.yaml, not here.
OUTPUT_DIR=output

# --- `resend`: re-deliver the original email from a second account ---
# Gmail needs an app password: https://myaccount.google.com/apppasswords (2FA required)
RESEND_SMTP_HOST=smtp.gmail.com
RESEND_SMTP_PORT=465
RESEND_SMTP_SECURITY=ssl
RESEND_SMTP_USER=
RESEND_SMTP_PASSWORD=
RESEND_SMTP_FROM=
RESEND_DAILY_CAP=100
RESEND_MIN_DAYS=4

# --- Funding follow-ups + meeting requests (`replies`) ---
FUNDING_FOLLOWUPS=2
FOLLOWUP_GAP_DAYS=2
MEET_MINUTES=20
MEET_LEAD_DAYS=2
# Professor's local hours / your hours (in MEET_MY_TZ) that a proposed slot must fit.
MEET_THEIR_HOURS=9-17
MEET_MY_HOURS=13-23
MEET_MY_TZ=Asia/Kolkata
# Optional fixed Meet/Zoom link to include in requests.
MEET_LINK=
# Google Calendar OAuth client (Desktop app) JSON; then run `calendar-auth`.
GOOGLE_CLIENT_SECRET=credentials.json
GOOGLE_CALENDAR_ID=primary
# Other From addresses that are you (so your own mails aren't read as the professor's).
MY_EMAIL_ALIASES=
